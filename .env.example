# Copy to .env.local and fill in. Never commit .env.local.

# Firebase Admin (server only) - from the service-account JSON
FIREBASE_PROJECT_ID=ai-support-desk-9c4ed
FIREBASE_CLIENT_EMAIL=your-service-account@ai-support-desk-9c4ed.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# n8n "send response" webhook (server only; NOT prefixed with NEXT_PUBLIC_)
# Production URL of the new webhook workflow. Must be https (http only for localhost).
# Leave unset to disable sending: the Send route then answers 503.
N8N_SEND_RESPONSE_WEBHOOK_URL=
# Optional but recommended: must match the Header Auth value configured on the n8n Webhook node.
N8N_SEND_RESPONSE_WEBHOOK_SECRET=
