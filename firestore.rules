rules_version = '2';

// DENY EVERYTHING to client SDKs and the public REST API.
//
// Why this is correct for this project:
//  - The dashboard never talks to Firestore from the browser. It uses no Firebase client SDK and no
//    Firebase Auth; sign-in is a signed cookie checked by the Next.js API routes, which read and write
//    Firestore with the Firebase Admin SDK.
//  - n8n reads and writes Firestore with a service account (Admin/OAuth2 credentials), not through
//    the client SDK.
//  - Both of those BYPASS these rules, so denying client access removes nothing the app uses.
//
// Collections this protects (all server-only): support_tickets (and its messages / events
// subcollections), knowledge_base, rate_limits, n8n_send_log,
// app_settings (dashboard preferences, written by /api/settings). There is no public read or write.
//
// If you later add a client-side Firebase feature, do not loosen this file: add a narrow `match`
// for that one path, require request.auth, and add a test in tests/security.test.ts.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
